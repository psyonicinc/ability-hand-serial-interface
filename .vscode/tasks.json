{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake-configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}",
                "-B", "${workspaceFolder}/build",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DBUILD_EXAMPLES=ON"
            ],
            "group": "build",
            "presentation": { "reveal": "always" }
        },
        {
            "label": "cmake-build",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "${workspaceFolder}/build", "--config", "Debug"],
            "group": { "kind": "build", "isDefault": true },
            "dependsOn": "cmake-configure",
            "presentation": { "reveal": "always" }
        }
    ]
}
